# Local integrated server. No third-party credentials are required.
HOST=127.0.0.1
PORT=8083
DATA_DIR=./server/data
# Optional separate static frontend, exact origin only:
ALLOWED_ORIGINS=http://127.0.0.1:8000
# Production only: persistent mount and controlled TLS reverse proxy required.
# NODE_ENV=production
# DURABLE_STORAGE=1
# TRUST_PROXY=1
# REQUIRE_HTTPS=1
