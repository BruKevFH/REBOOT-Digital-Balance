# Local integrated server. No third-party credentials are required.
HOST=127.0.0.1
PORT=8083
DATA_DIR=./server/data
# Optional PostgreSQL: inject DATABASE_URL securely in the process/environment.
# Do not put a real connection string or provider API keys in this file.
# If DATABASE_URL is set, PostgreSQL replaces SQLite; DATA_DIR is then unused.
# Optional separate static frontend, exact origin only:
ALLOWED_ORIGINS=http://127.0.0.1:8000
# Production: remote PostgreSQL OR durable SQLite mount, plus controlled TLS proxy.
# NODE_ENV=production
# Only for production SQLite on a real durable mount:
# DURABLE_STORAGE=1
# TRUST_PROXY=1
# REQUIRE_HTTPS=1
