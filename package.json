{
  "name": "reboot-neon-balance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REBOOT Neon Balance: a playable 3D browser game and offline download",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:ninja": "node scripts/build_ninja.mjs",
    "test:ninja": "node --test tests/ninja*.test.mjs",
    "package:ninja": "python3 scripts/package_ninja.py",
    "build:maze": "node scripts/build_maze.mjs",
    "test:maze": "node --test tests/maze.test.mjs",
    "package:maze": "python3 scripts/package_maze.py",
    "package": "python3 scripts/package_download.py",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1",
    "serve:ninja": "node --env-file-if-exists=.env server/ninja-service.mjs",
    "test:ninja:browser": "node scripts/check_ninja_browser.cjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=24"
  }
}
